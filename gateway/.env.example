# Public HTTPS origin of the target Supabase environment (no trailing slash).
GATEWAY_SUPABASE_URL=

# Provisioned gateway instance and its dedicated high-entropy token.
GATEWAY_INSTANCE_ID=
GATEWAY_TOKEN=

# Absolute local/UNC root. Keep Windows/SMB credentials outside this file.
GATEWAY_ROOT_PATH=

# Operational policy.
GATEWAY_BATCH_SIZE=10
GATEWAY_POLL_INTERVAL_MS=30000
GATEWAY_REQUEST_TIMEOUT_MS=30000
GATEWAY_DOWNLOAD_TIMEOUT_MS=120000
GATEWAY_MAX_REQUEST_RETRIES=3
GATEWAY_RETRY_BASE_MS=1000
GATEWAY_MAX_SYNC_ATTEMPTS=10
GATEWAY_LEASE_SECONDS=300
GATEWAY_MAX_UPLOAD_BYTES=20971520
