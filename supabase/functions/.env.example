# Public application origins accepted by browser-facing Edge Functions.
# Use comma-separated HTTPS origins in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Canonical frontend URL used in invitation and recovery redirects.
APP_PUBLIC_URL=http://127.0.0.1:5173

# Public Supabase API origin used to externalize short-lived Storage URLs.
STORAGE_PUBLIC_URL=http://127.0.0.1:54321

# Document upload policy. Keep this limit at or below the private bucket limit.
DOCUMENT_UPLOAD_MAX_BYTES=20971520
DOCUMENT_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain
